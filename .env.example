# ----- Banco de dados -----
# Desenvolvimento local (padrão): SQLite, sem necessidade de Docker.
DATABASE_URL="file:./dev.db"

# Produção / Docker Compose: Postgres.
# Troque também o `provider` em prisma/schema.prisma para "postgresql".
# DATABASE_URL="postgresql://enem:enem@localhost:5432/enem_study?schema=public"

# ----- Importação de questões (scripts/import-enem.ts) -----
# Base URL da API pública enem.dev.
ENEM_API_BASE="https://api.enem.dev/v1"
# Anos a importar (separados por vírgula).
ENEM_YEARS="2019,2020,2021,2022,2023"
# Delay (ms) entre requisições para respeitar o rate limit da API.
ENEM_REQUEST_DELAY_MS="350"
# Número máximo de tentativas em caso de 429/erro de rede.
ENEM_MAX_RETRIES="5"
